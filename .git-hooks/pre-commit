#!/usr/bin/env bash
# ============================================================
#  PROJECT 1 — pre-commit hook (custom, no pre-commit framework)
#  Runs on every git commit. Blocks commit if any check fails.
#  Install: bash scripts/bootstrap.sh (links this file automatically)
# ============================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

PASS=0
FAIL=0

header() { echo -e "\n${BOLD}$1${RESET}"; }
ok()     { echo -e "  ${GREEN}✓${RESET} $1"; ((PASS++)); }
warn()   { echo -e "  ${YELLOW}⚠${RESET} $1"; }
fail()   { echo -e "  ${RED}✗${RESET} $1"; ((FAIL++)); }

header "── Pre-commit security & quality checks ──"

# ── 1. Block .env files ──────────────────────────────────────
header "[1/7] Secret file detection"
BLOCKED_PATTERNS=(
  "\.env$"
  "\.env\."
  ".*_rsa$"
  ".*\.pem$"
  ".*\.key$"
  ".*client_secret.*\.json$"
  ".*credentials.*\.json$"
  ".*service.account.*\.json$"
  "ca\.pem$"
  "aiven.*\.pem$"
)
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)
BLOCKED=0
for pattern in "${BLOCKED_PATTERNS[@]}"; do
  while IFS= read -r file; do
    if [[ "$file" =~ $pattern ]]; then
      fail "BLOCKED: '$file' matches secret pattern '$pattern'"
      BLOCKED=1
    fi
  done <<< "$STAGED_FILES"
done
[[ $BLOCKED -eq 0 ]] && ok "No secret files staged"

# ── 2. Scan staged content for hardcoded secrets ─────────────
header "[2/7] Hardcoded secret pattern scan"
SECRET_PATTERNS=(
  "password\s*=\s*['\"][^'\"]{6,}"
  "secret\s*=\s*['\"][^'\"]{6,}"
  "api_key\s*=\s*['\"][^'\"]{6,}"
  "token\s*=\s*['\"][^'\"]{20,}"
  "-----BEGIN.*PRIVATE KEY-----"
  "AKIA[0-9A-Z]{16}"
  "ghp_[a-zA-Z0-9]{36}"
  "tenant_id\s*=\s*['\"][0-9a-f-]{36}"
)
SECRET_FOUND=0
for file in $STAGED_FILES; do
  [[ ! -f "$file" ]] && continue
  [[ "$file" == *.env.example ]] && continue
  [[ "$file" == *DECISIONS.md ]] && continue
  for pattern in "${SECRET_PATTERNS[@]}"; do
    if git show ":$file" 2>/dev/null | grep -iEq "$pattern"; then
      fail "Possible hardcoded secret in '$file' (pattern: $pattern)"
      SECRET_FOUND=1
    fi
  done
done
[[ $SECRET_FOUND -eq 0 ]] && ok "No hardcoded secrets detected"

# ── 3. Python: ruff lint (backend only) ─────────────────────
header "[3/7] Python linting (ruff)"
PY_STAGED=$(echo "$STAGED_FILES" | grep "\.py$" || true)
if [[ -n "$PY_STAGED" ]]; then
  if command -v ruff &>/dev/null; then
    if ruff check $PY_STAGED --quiet 2>/dev/null; then
      ok "ruff passed on staged Python files"
    else
      fail "ruff found issues — run: ruff check backend/ --fix"
    fi
  else
    warn "ruff not installed — skipping Python lint (pip install ruff)"
  fi
else
  ok "No Python files staged"
fi

# ── 4. Python: ruff format check ────────────────────────────
header "[4/7] Python format check (ruff format)"
if [[ -n "$PY_STAGED" ]]; then
  if command -v ruff &>/dev/null; then
    if ruff format $PY_STAGED --check --quiet 2>/dev/null; then
      ok "Python formatting is clean"
    else
      fail "Python formatting issues — run: ruff format backend/"
    fi
  fi
else
  ok "No Python files staged"
fi

# ── 5. TypeScript: eslint (frontend only) ───────────────────
header "[5/7] TypeScript linting (eslint)"
TS_STAGED=$(echo "$STAGED_FILES" | grep -E "\.(ts|tsx)$" || true)
if [[ -n "$TS_STAGED" ]]; then
  if command -v npx &>/dev/null && [[ -f "frontend/node_modules/.bin/eslint" ]]; then
    if (cd frontend && npx eslint $TS_STAGED --quiet 2>/dev/null); then
      ok "ESLint passed on staged TypeScript files"
    else
      fail "ESLint found issues — run: cd frontend && npm run lint"
    fi
  else
    warn "ESLint not available — run: cd frontend && npm install"
  fi
else
  ok "No TypeScript files staged"
fi

# ── 6. Blocked keywords ─────────────────────────────────────
header "[6/7] Blocked keyword scan"
BLOCKED_KEYWORDS=("TODO: remove" "FIXME: security" "import random" "DEBUG = True" "console.log(" "print(password" "print(secret")
KEYWORD_FOUND=0
for file in $STAGED_FILES; do
  [[ ! -f "$file" ]] && continue
  [[ "$file" == *.md ]] && continue
  for kw in "${BLOCKED_KEYWORDS[@]}"; do
    if git show ":$file" 2>/dev/null | grep -qF "$kw"; then
      fail "Blocked keyword '$kw' found in '$file'"
      KEYWORD_FOUND=1
    fi
  done
done
[[ $KEYWORD_FOUND -eq 0 ]] && ok "No blocked keywords detected"

# ── 7. Alembic: uncommitted migrations guard ────────────────
header "[7/7] Alembic migration consistency"
if echo "$STAGED_FILES" | grep -q "models/"; then
  if ! echo "$STAGED_FILES" | grep -q "db/migrations/versions/"; then
    warn "Model files changed but no new Alembic migration staged"
    warn "Run: cd backend && alembic revision --autogenerate -m 'describe_change'"
  else
    ok "Migration file staged alongside model change"
  fi
else
  ok "No model changes detected"
fi

# ── Summary ──────────────────────────────────────────────────
echo ""
echo -e "${BOLD}── Result: ${GREEN}${PASS} passed${RESET}${BOLD}, ${RED}${FAIL} failed${RESET} ──"
if [[ $FAIL -gt 0 ]]; then
  echo -e "${RED}${BOLD}Commit blocked. Fix the issues above and try again.${RESET}"
  echo -e "To bypass in emergency only: git commit --no-verify"
  exit 1
fi
echo -e "${GREEN}All checks passed. Committing...${RESET}"
exit 0
