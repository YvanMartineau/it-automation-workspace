#!/usr/bin/env bash
# ============================================================
#  PROJECT 1 — Enterprise-grade pre-commit hook (no framework)
#  Runs on every git commit. Blocks commit if any check fails.
#  Guarantees: every check reports PASS/FAIL explicitly.
# ============================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

PASS=0
FAIL=0

header() { echo -e "\n${BOLD}$1${RESET}"; }
ok()     { echo -e "  ${GREEN}✓${RESET} $1"; PASS=$((PASS + 1)); }
warn()   { echo -e "  ${YELLOW}⚠${RESET} $1"; }
fail()   { echo -e "  ${RED}✗${RESET} $1"; FAIL=$((FAIL + 1)); }

# Safe wrapper: prevents set -e from killing script
safe_run() {
  set +e
  "$@"
  local status=$?
  set -e
  return $status
}

header "── Enterprise pre-commit security & quality checks ──"

STAGED_FILES="$(git diff --cached --name-only 2>/dev/null || true)"

if [[ -z "${STAGED_FILES}" ]]; then
  ok "No files staged — nothing to check"
  echo ""
  echo -e "${BOLD}── Result: ${GREEN}${PASS} passed${RESET}${BOLD}, ${RED}${FAIL} failed${RESET} ──"
  echo -e "${GREEN}All checks passed. Committing...${RESET}"
  exit 0
fi

# ── 1/9 Secret file name detection ───────────────────────────
header "[1/9] Secret file name detection"

BLOCKED_FILE_PATTERNS=(
  "\.env$"
  "\.env\."
  ".*_rsa$"
  ".*\.pem$"
  ".*\.key$"
  ".*\.p12$"
  ".*\.jks$"
  ".*\.crt$"
  ".*\.der$"
  ".*client_secret.*\.json$"
  ".*credentials.*\.json$"
  ".*service\.account.*\.json$"
  "ca\.pem$"
  "aiven.*\.pem$"
  ".*\.n8n/credentials/.*"
)

BLOCKED=0
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  [[ "$file" =~ \.env\.example$ ]] && continue
  [[ "$file" == .git-hooks/* ]] && continue

  for pattern in "${BLOCKED_FILE_PATTERNS[@]}"; do
    if [[ "$file" =~ $pattern ]]; then
      fail "BLOCKED: '$file' matches secret-bearing pattern '$pattern'"
      BLOCKED=1
    fi
  done
done <<< "${STAGED_FILES}"

[[ $BLOCKED -eq 0 ]] && ok "No secret-like files staged"

# ── 2/9 Large file size guard ────────────────────────────────
header "[2/9] Large file size guard (1MB limit)"

SIZE_BLOCKED=0
MAX_SIZE_BYTES=1000000

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  [[ "$file" == .git-hooks/* ]] && continue
  [[ ! -f "$file" ]] && continue

  size=$(safe_run wc -c <"$file" 2>/dev/null || echo 0)

  if [[ "$size" -gt "$MAX_SIZE_BYTES" ]]; then
    fail "File '$file' exceeds ${MAX_SIZE_BYTES} bytes (${size}) — blocked"
    SIZE_BLOCKED=1
  fi
done <<< "${STAGED_FILES}"

[[ $SIZE_BLOCKED -eq 0 ]] && ok "No oversized files staged"

# ── 3/9 Binary / archive secret guard ────────────────────────
header "[3/9] Binary / archive secret guard"

BINARY_PATTERNS=(
  ".*\.zip$"
  ".*\.tar$"
  ".*\.tar\.gz$"
  ".*\.tgz$"
  ".*\.p12$"
  ".*\.jks$"
  ".*\.der$"
)

BINARY_BLOCKED=0
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  [[ "$file" == .git-hooks/* ]] && continue

  for pattern in "${BINARY_PATTERNS[@]}"; do
    if [[ "$file" =~ $pattern ]]; then
      fail "Binary/archive file '$file' blocked (pattern: $pattern)"
      BINARY_BLOCKED=1
    fi
  done
done <<< "${STAGED_FILES}"

[[ $BINARY_BLOCKED -eq 0 ]] && ok "No binary/archive files staged"

# ── 4/9 Hardcoded secret pattern scan ────────────────────────
header "[4/9] Hardcoded secret pattern scan"

SECRET_PATTERNS=(
  "['\"]?(password|passwd|secret|token|api[_-]?key)['\"]?\s*[:=]\s*['\"][^'\"]{4,}"
  "^(PASSWORD|SECRET|TOKEN|API_KEY|SENDGRID_API_KEY|SMTP_PASSWORD)=[^[:space:]]{4,}"
  "eyJ[A-Za-z0-9_-]*\.[A-Za-z0-9_-]*\.[A-Za-z0-9_-]*"
  "AKIA[0-9A-Z]{16}"
  "ghp_[A-Za-z0-9]{36}"
  "gho_[A-Za-z0-9]{36}"
  "glpat-[A-Za-z0-9_-]{20,}"
  "-----BEGIN.*PRIVATE KEY-----"
)

SECRET_FOUND=0
while IFS= read -r file; do
  [[ -z "$file" || ! -f "$file" ]] && continue
  [[ "$file" == *.env.example ]] && continue
  [[ "$file" == *DECISIONS.md ]] && continue
  [[ "$file" == .git-hooks/* ]] && continue
  [[ "$file" == *package-lock.json ]] && continue

  if safe_run file "$file" | grep -qiE "text|utf-8"; then
    for pattern in "${SECRET_PATTERNS[@]}"; do
      if safe_run git show ":$file" | grep -Ei "$pattern" >/dev/null; then
        fail "Possible hardcoded secret in '$file' (pattern: $pattern)"
        SECRET_FOUND=1
      fi
    done
  fi
done <<< "${STAGED_FILES}"

[[ $SECRET_FOUND -eq 0 ]] && ok "No hardcoded secrets detected"

# ── 5/9 High-entropy token heuristic ─────────────────────────
header "[5/9] High-entropy token heuristic"

ENTROPY_PATTERNS=(
  "[A-Za-z0-9]{32,}"
  "[A-Fa-f0-9]{64}"
  "[A-Za-z0-9+/]{44}={0,2}"
)

ENTROPY_FOUND=0
while IFS= read -r file; do
  [[ -z "$file" || ! -f "$file" ]] && continue
  [[ "$file" == *.env.example ]] && continue
  [[ "$file" == *DECISIONS.md ]] && continue
  [[ "$file" == .git-hooks/* ]] && continue
  [[ "$file" == *package-lock.json ]] && continue

  if safe_run file "$file" | grep -qiE "text|utf-8"; then
    for pattern in "${ENTROPY_PATTERNS[@]}"; do
      if safe_run git show ":$file" | grep -E "$pattern" >/dev/null; then
        warn "High-entropy string detected in '$file' (pattern: $pattern) — review manually"
        ENTROPY_FOUND=1
      fi
    done
  fi
done <<< "${STAGED_FILES}"

[[ $ENTROPY_FOUND -eq 0 ]] && ok "No high-entropy tokens detected (heuristic)"

# ── 6/9 Security-sensitive keyword scan ──────────────────────
header "[6/9] Security-sensitive keyword scan"

BLOCKED_KEYWORDS_REGEX=(
  "TODO:\s*remove"
  "FIXME:\s*security"
  "import\s+random"
  "DEBUG\s*=\s*True"
  "console\s*\.\s*log\s*\("
  "console\s*\.\s*(debug|info|warn|error)\s*\(.*secret"
  "print\s*\(\s*password"
  "print\s*\(\s*secret"
  "logger\.(info|debug|warning|error)\s*\(.*secret"
)

KEYWORD_FOUND=0
while IFS= read -r file; do
  [[ -z "$file" || ! -f "$file" ]] && continue
  [[ "$file" == *.md ]] && continue
  [[ "$file" == .git-hooks/* ]] && continue

  if safe_run file "$file" | grep -qiE "text|utf-8"; then
    for kw in "${BLOCKED_KEYWORDS_REGEX[@]}"; do
      if safe_run git show ":$file" | grep -Eq "$kw"; then
        fail "Blocked keyword pattern '$kw' found in '$file'"
        KEYWORD_FOUND=1
      fi
    done
  fi
done <<< "${STAGED_FILES}"

[[ $KEYWORD_FOUND -eq 0 ]] && ok "No blocked security-sensitive keywords detected"

# ── 7/9 Python linting & formatting ──────────────────────────
header "[7/9] Python linting & formatting (ruff, backend/)"

PY_STAGED="$(echo "${STAGED_FILES}" | grep "\.py$" || true)"
PY_FAIL=0

if [[ -n "${PY_STAGED}" ]]; then
  if command -v ruff &>/dev/null; then
    if safe_run ruff check backend/ --quiet; then
      ok "ruff check passed on backend/"
    else
      fail "ruff check found issues — run: ruff check backend/ --fix"
      PY_FAIL=1
    fi
    if safe_run ruff format --check backend/ --quiet; then
      ok "ruff format check passed on backend/"
    else
      fail "ruff format check failed — run: ruff format backend/"
      PY_FAIL=1
    fi
  else
    warn "ruff not installed — skipping Python lint/format"
  fi
else
  ok "No Python files staged"
fi

# ── 8/9 TypeScript linting ───────────────────────────────────
header "[8/9] TypeScript linting (eslint, frontend/)"

FRONTEND_DIR="frontend"
TS_STAGED="$(echo "${STAGED_FILES}" | grep -E "\.(ts|tsx)$" || true)"
TS_FAIL=0

if [[ -n "${TS_STAGED}" ]]; then
  if command -v npx &>/dev/null && [[ -f "${FRONTEND_DIR}/node_modules/.bin/eslint" ]]; then
    # Strip the "frontend/" prefix so paths are relative to FRONTEND_DIR,
    # since we cd into it before invoking eslint.
    TS_ARGS="$(echo "${TS_STAGED}" | sed "s|^${FRONTEND_DIR}/||" | tr '\n' ' ')"
    if safe_run bash -c "cd ${FRONTEND_DIR} && npx eslint ${TS_ARGS} --quiet"; then
      ok "ESLint passed on staged TypeScript files"
    else
      fail "ESLint found issues — run: cd ${FRONTEND_DIR} && npm run lint"
      TS_FAIL=1
    fi
  else
    warn "ESLint not available — run: cd ${FRONTEND_DIR} && npm install"
  fi
else
  ok "No TypeScript files staged"
fi

# ── 9/9 Alembic migration consistency ────────────────────────
header "[9/9] Alembic migration consistency"

MODELS_CHANGED=0
MIGRATIONS_STAGED=0

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  [[ "$file" == .git-hooks/* ]] && continue

  if [[ "$file" =~ ^backend/.*/models/ ]] || [[ "$file" =~ ^backend/.*/db/models/ ]]; then
    MODELS_CHANGED=1
  fi
  if [[ "$file" =~ ^backend/db/migrations/versions/ ]]; then
    MIGRATIONS_STAGED=1
  fi
done <<< "${STAGED_FILES}"

if [[ $MODELS_CHANGED -eq 1 ]]; then
  if [[ $MIGRATIONS_STAGED -eq 0 ]]; then
    warn "Model files changed but no new Alembic migration staged"
    warn "Run: cd backend && alembic revision --autogenerate -m 'describe_change'"
  else
    ok "Migration file staged alongside model change"
  fi
else
  ok "No model changes detected"
fi

# ── Summary ──────────────────────────────────────────────────
echo ""
echo -e "${BOLD}── Result: ${GREEN}${PASS} passed${RESET}${BOLD}, ${RED}${FAIL} failed${RESET} ──"

if [[ $FAIL -gt 0 ]]; then
  echo -e "${RED}${BOLD}Commit blocked. Fix the issues above and try again.${RESET}"
  exit 1
fi

echo -e "${GREEN}All checks passed. Committing...${RESET}"
exit 0