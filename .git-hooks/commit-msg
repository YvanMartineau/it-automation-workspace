#!/usr/bin/env bash
# ============================================================
#  commit-msg hook — enforces Conventional Commits format
#  Format: type(scope): description
#  Types: feat|fix|docs|style|refactor|test|chore|security|ci
#  Example: feat(onboard): add Graph API user creation
#  Example: security(auth): replace random with secrets module
# ============================================================
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

PATTERN='^(feat|fix|docs|style|refactor|test|chore|security|ci|perf|build)(\([a-z0-9/_-]+\))?: .{1,100}$'

if [[ "$COMMIT_MSG" =~ ^Merge ]] || [[ "$COMMIT_MSG" =~ ^Revert ]]; then
  exit 0
fi

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "  ✗ Commit message rejected — does not follow Conventional Commits"
  echo ""
  echo "  Format:  type(scope): description"
  echo "  Example: feat(scanner): add async subnet scan with SSE"
  echo "  Example: security(auth): store refresh token in httpOnly cookie"
  echo "  Example: fix(onboard): handle Graph API timeout gracefully"
  echo ""
  echo "  Valid types: feat | fix | docs | style | refactor | test | chore | security | ci | perf | build"
  echo "  Your message: '$COMMIT_MSG'"
  echo ""
  exit 1
fi
exit 0
