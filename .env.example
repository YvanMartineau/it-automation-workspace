# ============================================================
#  PROJECT 1 — IT Automation Platform
#  .env.example — SAFE TO COMMIT — no real values here
#  Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── Database (Aiven PostgreSQL) ──────────────────────────────
# asyncpg requires ssl=require (NOT sslmode=require)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME?ssl=require

# Local dev only (docker-compose postgres_local service)
DEV_DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/automation_dev

# Test suite (separate DB — never run tests against Aiven)
TEST_DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/automation_test

# ── Seed Data ─────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@dev.de"
SEED_ADMIN_PASSWORD="Replace"

# ── JWT Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 bytes (64 hex chars). Rotate immediately if exposed.
JWT_SECRET_KEY=6a3d...
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Microsoft Graph API (Entra ID) ───────────────────────────
# App registration: Entra ID portal → App registrations → New registration
# Permission: User.ReadWrite.All (application, not delegated)
# Client secret: shown ONCE — save immediately to this file
#GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#GRAPH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
#GRAPH_DEFAULT_GROUP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── n8n Webhooks ─────────────────────────────────────────────
# n8n running locally: http://localhost:5678/webhook/...
# n8n on Oracle VM via Cloudflare: https://your-domain.com/n8n/webhook/...
N8N_ONBOARDING_WEBHOOK_URL=http://localhost:5678/webhook/onboarding 
N8N_WEBHOOK_TIMEOUT_SECONDS=5
N8N_OFFBOARDING_WEBHOOK_URL=http://localhost:5678/webhook/offboarding
N8N_HEADER_AUTH=x-callback-secret
N8N_CALLBACK_SECRET=96d3...

# ── Seed ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@dev.de
SEED_ADMIN_PASSWORD=Replace

SEED_VIEWER_EMAIL=viewer@dev.de
SEED_VIEWER_PASSWORD=Replace


# ── performance test ─────────────────────────────────────────────
PERF_USER_EMAIL=admin@dev.de
PERF_USER_PASSWORD=Replace
PERF_BASE_URL=http://127.0.0.1:8000
SCAN_SUBNET=192.168.179.0/24

# ── OpenLDAP ─────────────────────────────────────────────
LDAP_INIT_ORG_DN=DC=itautomation,DC=local
LDAP_INIT_ORG_NAME=IT Automation Platform
LDAP_INIT_ROOT_USER_DN=cn=admin,DC=itautomation,DC=local
LDAP_INIT_ROOT_USER_PW=Replace
#if you want to use the same password for the bind user, you can set it here. Otherwise, set a different password for the bind user.
LDAP_BIND_PASSWORD=Replace
LDAP_ADMIN_PASSWORD=Replace

LDAP_INIT_RFC2307BIS_SCHEMA=1   # groupOfNames + member/memberOf (DN-based), not memberUid
LDAP_TLS_ENABLED=false          # internal Docker-network traffic only 

# ── Gmail SMTP (OAuth2 — never basic auth) ───────────────────
# Google Cloud Console → APIs → Gmail API → OAuth2 credentials
GMAIL_OAUTH_CLIENT_ID=67104...apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=GOCSPX-...
GMAIL_OAUTH_REFRESH_TOKEN=1//04Bdj....
GMAIL_SENDER_ADDRESS=martineaubadou9@gmail.com
ADMIN_ALERT_EMAIL=admin@dev.de 

# ── JIRA ─────────────────────────────────────────────────
JIRA_API= ATATT3...
# ── PGADMIN ─────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@dev.de
PGADMIN_DEFAULT_PASSWORD=Replace

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=automation_dev
POSTGRES_USER=Replace
POSTGRES_PASSWORD=Replace

# ── Frontend ─────────────────────────────────────────────────
# Used for CORS allowed origins
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://your-project.vercel.app

# ── Cloudflare Tunnel ────────────────────────────────────────
# Set after cloudflared tunnel create — used in nginx config
CLOUDFLARE_TUNNEL_TOKEN=REPLACE

# ── Scanning ─────────────────────────────────────────────────
# Restrict scanning to this subnet only — validated on every scan request
ALLOWED_SCAN_SUBNET=192.168.179.0/24 #For Local(Discovers my WIFI devices) and #192.168.1.0/24 for Prod

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
# production | development
LOG_LEVEL=INFO
