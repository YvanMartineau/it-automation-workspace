# ============================================================
#  PROJECT 1 — IT Automation Platform
#  .env.example — SAFE TO COMMIT — no real values here
#  Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── Database (Aiven PostgreSQL) ──────────────────────────────
# asyncpg requires ssl=require (NOT sslmode=require)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME?ssl=require

# Local dev only (docker-compose postgres_local service)
DEV_DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/automation_dev

# Test suite (separate DB — never run tests against Aiven)
TEST_DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/automation_test

# ── JWT Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 bytes (64 hex chars). Rotate immediately if exposed.
JWT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Microsoft Graph API (Entra ID) ───────────────────────────
# App registration: Entra ID portal → App registrations → New registration
# Permission: User.ReadWrite.All (application, not delegated)
# Client secret: shown ONCE — save immediately to this file
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
GRAPH_DEFAULT_GROUP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── n8n Webhooks ─────────────────────────────────────────────
# n8n running locally: http://localhost:5678/webhook/...
# n8n on Oracle VM via Cloudflare: https://your-domain.com/n8n/webhook/...
N8N_ONBOARDING_WEBHOOK_URL=http://localhost:5678/webhook/onboarding
N8N_WEBHOOK_TIMEOUT_SECONDS=5

# ── Gmail SMTP (OAuth2 — never basic auth) ───────────────────
# Google Cloud Console → APIs → Gmail API → OAuth2 credentials
GMAIL_OAUTH_CLIENT_ID=REPLACE.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=REPLACE
GMAIL_OAUTH_REFRESH_TOKEN=REPLACE
GMAIL_SENDER_ADDRESS=your-email@gmail.com
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# ── Frontend ─────────────────────────────────────────────────
# Used for CORS allowed origins
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://your-project.vercel.app

# ── Cloudflare Tunnel ────────────────────────────────────────
# Set after cloudflared tunnel create — used in nginx config
CLOUDFLARE_TUNNEL_TOKEN=REPLACE

# ── Scanning ─────────────────────────────────────────────────
# Restrict scanning to this subnet only — validated on every scan request
ALLOWED_SCAN_SUBNET=192.168.1.0/24

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
# production | development
LOG_LEVEL=INFO
