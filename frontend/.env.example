# ── Frontend environment variables ───────────────────────────
# Copy to .env.local (Vite loads .env.local automatically)
# NEVER commit .env.local

# FastAPI backend URL
# Dev:  http://localhost:8000  (Vite proxy rewrites /api → this)
# Prod: https://your-domain.com
VITE_API_URL=http://localhost:8000

# App metadata
VITE_APP_TITLE=IT Automation Platform
VITE_APP_ENV=development
